# ============================================================
# GLM-4.6V-Flash 图像理解 MCP —— 环境变量模板
# 复制为 .env 并填写你的 Key（或直接运行 install.sh / install.ps1）
# ============================================================

# 必填：智谱开放平台 API Key（免费申请）
# 获取地址：https://open.bigmodel.cn/usercenter/apikeys
ZHIPU_API_KEY=粘贴你的Key

# ---- 以下均为可选覆盖项 ----
# API 端点（一般无需修改）
# GLM_API_BASE=https://open.bigmodel.cn/api/paas/v4/chat/completions

# 模型 ID（免费视觉模型；也可换成 glm-4.6v 等付费模型）
# GLM_MODEL=glm-4.6v-flash

# 请求超时秒数（默认 120）
# GLM_TIMEOUT=120

# 默认最大输出 token 数（模型上下文 128K，默认 4096）
# GLM_MAX_TOKENS=4096

# 设为 1 时把 http(s) 图片下载为 base64 后再提交（默认 0：直接传 URL）
# GLM_DOWNLOAD_REMOTE=0

# 429/5xx 重试参数
# GLM_RETRY_DELAY=3
# GLM_MAX_RETRIES=3
